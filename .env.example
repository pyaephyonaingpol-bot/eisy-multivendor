# ---------------------------------------------------------------------------
# Supabase environment variables for EISY Multivendor
# ---------------------------------------------------------------------------
# 1. Create a project at https://supabase.com/dashboard
# 2. Open Project Settings → API
# 3. Copy this file:  cp .env.example .env.local
# 4. Paste your Project URL and keys below (never commit .env.local)
# 5. Run supabase/migrations in order in the SQL Editor (or supabase db push).
#    If public.profiles is empty, paste and run:
#      supabase/scripts/upsert_bootstrap_admin_profile.sql
#    (uses only id, email, full_name, role — requires Auth user to exist)
#    Or: node scripts/ensure-bootstrap-admin.mjs with SUPABASE_SERVICE_ROLE_KEY
# 6. Auth → URL Configuration: add http://localhost:3000/auth/callback
# ---------------------------------------------------------------------------

# Used for email confirmation redirects (optional in local dev; derived from request if unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (Supabase Dashboard → Authentication → Providers → Google)
# Enable Google, add Client ID/Secret from Google Cloud Console, and add
# redirect URL: https://<project-ref>.supabase.co/auth/v1/callback
# Also allow http://localhost:3000/auth/callback (and your production URL)
# under Authentication → URL Configuration → Redirect URLs.

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (Settings → API → Project API keys → anon public)
# Safe to expose in the browser; protected by Row Level Security.
# Newer Supabase dashboards may label this as the "publishable" key — either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional alias used by some Supabase projects:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# service_role key (Settings → API → Project API keys → service_role)
# Server-only. Never expose this to the browser or commit it.
# Used later for admin tasks and webhooks that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for /api/cron/* routes (Vercel Cron Authorization: Bearer …)
CRON_SECRET=generate-a-long-random-string

# USDT TRC-20 payment gateway (webhook: /api/payments/usdt/webhook)
# Prefer HD: a 12-word BIP-39 mnemonic derives unique per-order deposit addresses
# (m/44'/195'/0'/0/{index}). Private keys never leave the server.
# USDT_TRC20_HD_MNEMONIC=word1 word2 ... word12
# Optional shared/fallback address (used when HD mnemonic is unset)
USDT_TRC20_DEPOSIT_ADDRESS=your-tron-deposit-address
# Optional override; defaults to official USDT TRC-20 contract
# USDT_TRC20_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Prefer a dedicated webhook secret; falls back to CRON_SECRET.
# Webhook always verifies on-chain via TronGrid (skip_chain_verify is rejected).
USDT_WEBHOOK_SECRET=generate-a-long-random-string
# Optional TronGrid API key for chain verification + deposit monitor
# TRONGRID_API_KEY=
# TRONGRID_API_BASE=https://api.trongrid.io
#
# Wallet sweep / withdrawal broadcast worker
# mock (default) | manual (admin attaches tx hash) | live (HD child key or hot wallet key)
# USDT_WALLET_OPS_MODE=mock
# Cold/treasury address for auto-sweeps (also set auto_sweep_enabled in usdt_payment_settings)
# USDT_TRC20_SWEEP_DESTINATION=
# Hot wallet private key — server only; never expose to the browser
# (optional when USDT_TRC20_HD_MNEMONIC is set — child keys are derived for sweeps)
# USDT_TRC20_HOT_WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# External dropshipping platforms (CJ, DSers, Spocket, Printful, Printify)
# ---------------------------------------------------------------------------
# mock (default without keys) | live
# SUPPLIER_INTEGRATIONS_MODE=live
# Set to 0 to disable mock fallback when live calls fail
# SUPPLIER_INTEGRATIONS_FALLBACK_MOCK=1
#
# Shared webhook secret for /api/webhooks/{cj,dsers,spocket,printful,printify}
# Falls back to CRON_SECRET. Per-provider override: SUPPLIER_WEBHOOK_SECRET_PRINTFUL=...
# SUPPLIER_WEBHOOK_SECRET=
#
# CJ Dropshipping API 2.0
# CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
# CJ_ACCESS_TOKEN=
# CJ_API_KEY=
#
# DSers / AliExpress bridge (your DSers-connected middleware base URL)
# DSERS_API_BASE=https://api.dsers.com/v1
# DSERS_API_KEY=
#
# Spocket
# SPOCKET_API_BASE=https://api.spocket.co/v1
# SPOCKET_API_KEY=
#
# Printful POD
# PRINTFUL_API_BASE=https://api.printful.com
# PRINTFUL_API_KEY=
#
# Printify POD (shop id required for products + orders)
# Create a Personal Access Token at https://printify.com/app/account/api
# PRINTIFY_API_BASE=https://api.printify.com/v1
# PRINTIFY_API_KEY=
# PRINTIFY_SHOP_ID=
# Client helper: src/lib/printify.ts (fetch products, submit orders on purchase)
