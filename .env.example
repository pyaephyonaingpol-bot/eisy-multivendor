# ---------------------------------------------------------------------------
# Supabase environment variables for EISY Multivendor
# ---------------------------------------------------------------------------
# 1. Create a project at https://supabase.com/dashboard
# 2. Open Project Settings → API
# 3. Copy this file:  cp .env.example .env.local
# 4. Paste your Project URL and keys below (never commit .env.local)
# 5. Run supabase/migrations/001_initial_schema.sql, then 002–004 in SQL Editor
#    (004 bootstraps admin for pyaephyonaing.pol@gmail.com on signup)
# 6. Auth → URL Configuration: add http://localhost:3000/auth/callback
# ---------------------------------------------------------------------------

# Used for email confirmation redirects (optional in local dev; derived from request if unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (Settings → API → Project API keys → anon public)
# Safe to expose in the browser; protected by Row Level Security.
# Newer Supabase dashboards may label this as the "publishable" key — either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional alias used by some Supabase projects:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# service_role key (Settings → API → Project API keys → service_role)
# Server-only. Never expose this to the browser or commit it.
# Used later for admin tasks and webhooks that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for /api/cron/* routes (Vercel Cron Authorization: Bearer …)
CRON_SECRET=generate-a-long-random-string

# USDT TRC-20 payment gateway (webhook: /api/payments/usdt/webhook)
USDT_TRC20_DEPOSIT_ADDRESS=your-tron-deposit-address
# Optional override; defaults to official USDT TRC-20 contract
# USDT_TRC20_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Prefer a dedicated webhook secret; falls back to CRON_SECRET.
# Webhook always verifies on-chain via TronGrid (skip_chain_verify is rejected).
USDT_WEBHOOK_SECRET=generate-a-long-random-string
# Optional TronGrid API key for chain verification
# TRONGRID_API_KEY=
# TRONGRID_API_BASE=https://api.trongrid.io

# ---------------------------------------------------------------------------
# External dropshipping platforms (CJ Dropshipping + DSers / AliExpress)
# ---------------------------------------------------------------------------
# mock (default without keys) | live
# SUPPLIER_INTEGRATIONS_MODE=mock
# Set to 0 to disable mock fallback when live calls fail
# SUPPLIER_INTEGRATIONS_FALLBACK_MOCK=1
#
# CJ Dropshipping API 2.0
# CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
# CJ_ACCESS_TOKEN=
# CJ_API_KEY=
#
# DSers / AliExpress bridge (your DSers-connected middleware base URL)
# DSERS_API_BASE=https://api.dsers.com/v1
# DSERS_API_KEY=
